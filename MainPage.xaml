<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NextPage.Mobile.MainPage"
    BackgroundColor="#F5F5F5"
    Title="NextPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabeçalho -->
        <VerticalStackLayout
            Grid.Row="0"
            BackgroundColor="#172554"
            Padding="20"
            Spacing="12">

            <Label
                Text="NextPage"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center" />

            <Label
                Text="Sua próxima leitura começa aqui!"
                FontSize="14"
                TextColor="#DBEAFE"
                HorizontalOptions="Center" />

            <Entry
                x:Name="PesquisaEntry"
                Placeholder="Pesquisar livros..."
                BackgroundColor="White"
                TextColor="#111827"
                PlaceholderColor="#6B7280" />

        </VerticalStackLayout>

        <!-- Catálogo de livros -->
        <Grid Grid.Row="1" Padding="15" RowDefinitions="Auto,*">

            <Label
        Grid.Row="0"
        Text="Catálogo de Livros"
        FontSize="23"
        FontAttributes="Bold"
        TextColor="#172554"
        Margin="5,10,5,15" />

            <CollectionView
        x:Name="LivrosCollectionView"
        Grid.Row="1"
        SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="15"
                    Margin="5,5,5,10">

                            <VerticalStackLayout Spacing="8">


                                <Image
                            Source="{Binding ImagemCompleta}"
                            HeightRequest="180"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Margin="0,0,0,10" />


                                <Label
                            Text="{Binding Titulo}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#172554" />

                                <Label
                            Text="{Binding Autor}"
                            FontSize="14"
                            TextColor="#6B7280" />

                                <Label
                            Text="{Binding Genero.Nome}"
                            FontSize="13"
                            TextColor="#2563EB" />

                                <Label
                            Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#16A34A" />

                                <Button
                            Text="Ver detalhes"
                            BackgroundColor="#2563EB"
                            TextColor="White" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- Menu inferior -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*"
            BackgroundColor="#172554"
            Padding="10">

            <Button
                Grid.Column="0"
                Text="Início"
                BackgroundColor="#2563EB"
                TextColor="White" />

            <Button
                Grid.Column="1"
                Text="Carrinho"
                BackgroundColor="Transparent"
                TextColor="White" />

            <Button
                Grid.Column="2"
                Text="Minha Conta"
                BackgroundColor="Transparent"
                TextColor="White" />

        </Grid>

    </Grid>

</ContentPage>
